# ============================================================
# 1. 基础镜像 (Base Image)
#
# FROM         Docker 指令: 指定当前镜像基于哪个基础镜像构建
# python       镜像名称: Docker Hub 上的官方 Python 镜像
# 3.11         Python 版本号: 使用 Python 3.11.x
# -slim        tag(标签/变体):
#                - slim = 精简版, 只包含运行 Python 所需的最小系统库,
#                  去掉了编译工具和文档, 镜像体积更小, 下载更快,
#                  适合生产环境部署
#                常见变体: alpine(超轻量) / slim(精简) / 默认(完整)
# ============================================================
FROM python:3.11-slim

# ============================================================
# 1.5. 安装系统依赖 (System Dependencies)
#
# uvicorn[standard] 依赖 uvloop 和 httptools，
# 这两个包在编译时需要 gcc 和系统头文件。
# 安装后再清理 apt 缓存，减小镜像体积。
# ============================================================
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 2. 设置工作目录 (Working Directory)
#
# WORKDIR      Docker 指令: 设置容器内的工作目录(当前路径)
#               相当于在容器里执行了 `cd /app`
#               如果 /app 目录不存在, Docker 会自动创建它
#               后续的 COPY、RUN、CMD 等指令都会在这个目录下执行
# /app         目录路径: 约定俗成用 /app 作为应用代码的根目录
# ============================================================
WORKDIR /app

# ============================================================
# 3. 复制依赖文件并安装依赖
#
# --- 第 8 行 ---
# COPY         Docker 指令: 把宿主机(你的电脑)的文件复制到容器里
#               语法: COPY <宿主机路径> <容器内路径>
# requirements.txt
#              宿主机路径(源): 当前构建上下文(context)下的 requirements.txt
#              构建上下文 = docker build 命令中 `.` 指定的目录
# .            容器内路径(目标): `.` = 当前工作目录 = /app(WORKDIR 设置的)
#               所以最终是复制到 /app/requirements.txt
#
# 【为什么要先复制 requirements.txt 再复制全部代码?】
# Docker 构建是分层的(layer), 每一行指令生成一层.
# COPY requirements.txt . 和 RUN pip install... 这两层
# 只有 requirements.txt 变了才会重新执行;
# 如果只改业务代码, 依赖层可以直接复用缓存, 构建速度大幅提升.
# ============================================================
COPY requirements.txt .

# --- 第 9 行 ---
# RUN          Docker 指令: 在容器内执行 shell 命令
#               注意: RUN 是在 构建镜像时(build time) 执行的,
#               不是容器启动时执行的
# pip          Python 官方包管理器, 用来安装第三方库
# install      pip 的子命令: 安装包
# --no-cache-dir
#              安装时不保存缓存文件到容器里,
#              可以减小最终镜像的体积(生产环境不需要缓存)
# -r           从文件读取依赖列表并安装
#              -r = --requirement
# requirements.txt
#              刚才复制进来的依赖清单文件
# ============================================================
RUN pip install --no-cache-dir -r requirements.txt

# ============================================================
# 4. 把项目代码全部复制进容器
#
# COPY         Docker 指令: 复制文件
# .            源: 宿主机当前构建上下文的所有文件/目录
# .            目标: 容器的当前工作目录 = /app
#
# 因为前面已复制过 requirements.txt, 这里会再次复制它(覆盖),
# 但不影响缓存策略——上面依赖层已生成, 这里的覆盖不会让它重新跑.
# ============================================================
COPY . .

# ============================================================
# 5. 声明容器对外暴露的端口
#
# EXPOSE       Docker 指令: 声明容器运行时监听的端口
#              注意: EXPOSE 只是 声明/文档作用, 并不会实际打开端口!
#              真正映射端口需要在 docker run 时加 -p 参数:
#                 docker run -p 8000:8000 <镜像名>
#                 含义: 宿主机的8000 → 容器的8000
# 8000         端口号: FastAPI 默认端口, 也可以是其他端口
# ============================================================
EXPOSE 8000

# ============================================================
# 6. 容器启动时执行的命令 (Entrypoint / Command)
#
# CMD          Docker 指令: 指定容器启动时(run time)默认执行的命令
#              注意: CMD 在构建时不执行, 只在 docker run 时执行
#              与 RUN 的区别:
#                RUN  → 构建时(build time)执行, 用于安装等
#                CMD  → 启动时(run time) 执行, 用于启动应用
# ["..."]      JSON 数组格式(exec form):
#               每个元素是一个独立的参数, 不经过 shell 解析,
#               推荐使用此格式, 信号传递更干净(能收到 SIGTERM)
# uvicorn      ASGI 服务器: 运行异步 Python Web 应用的服务器
#              FastAPI 底层依赖它, 类似 Node.js 的 nodemon
# main:app     Python 模块路径:
#              main → 模块名 (项目根目录下的 main.py 文件)
#              app  → 变量名 (main.py 里 app = FastAPI() 这个实例)
#              合起来: 告诉 uvicorn 去 main.py 文件中找 app 对象
# --host       监听的主机地址
# 0.0.0.0     "监听所有网络接口":
#              127.0.0.1 = 只允许容器内部访问
#              0.0.0.0   = 允许外部(宿主机)访问容器
#              Docker 容器默认是隔离网络的, 必须用 0.0.0.0
#              才能让宿主机通过端口映射访问到
# --port       监听的端口号
# 8000         与上面 EXPOSE 的端口保持一致
# ============================================================
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]